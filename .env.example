# Copy to .env and fill in your values
GITHUB_TOKEN=ghp_your_token_here
SYNC_CRON=0 0 * * *
TZ=Europe/Athens

# Optional: Set a password to protect app installation, editing, visibility toggling, version switching, and sync triggers in the UI/API.
# Leave empty or unset to allow unrestricted public management (default).
# Note: When exposing ArtCraft Hub outside localhost, always serve behind HTTPS.
ADMIN_PASSWORD=
